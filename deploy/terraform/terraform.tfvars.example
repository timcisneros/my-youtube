# Hetzner Cloud Configuration for my-youtube
# Copy this file to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars

# Prefer HCLOUD_TOKEN in your shell for production automation.
hcloud_token = "your_hetzner_cloud_token_here"

# SSH access
ssh_public_key  = "ssh-ed25519 AAAA... you@example.com"
ssh_allowed_ips = ["1.2.3.4/32"]  # Your IP address

# Location and domain
location = "fsn1"
domain   = "yourtube.example.com"

# Server sizes (adjust for your workload)
web_server_type    = "cx22"  # 2 vCPU, 4GB
worker_server_type = "cx32"  # 4 vCPU, 8GB
db_server_type     = "cx22"  # 2 vCPU, 4GB

# PostgreSQL volume
db_volume_size = 50  # GB

# Credentials — generate strong random values with: openssl rand -hex 32
postgres_password = "CHANGE_ME_postgres_password"
redis_password    = "CHANGE_ME_redis_password"
session_secret    = "CHANGE_ME_session_hex_secret"
stream_secret     = "CHANGE_ME_stream_hex_secret"
