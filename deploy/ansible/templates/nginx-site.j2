# my-youtube nginx config — managed by Ansible

upstream my_youtube {
    server 127.0.0.1:3000;
    keepalive 64;
}

# Rate limiting zones
limit_req_zone $binary_remote_addr zone=general:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=extraction:10m rate=2r/m;

map $http_upgrade $my_youtube_connection_upgrade {
    default upgrade;
    '' close;
}

map $arg_v $my_youtube_runtime_cache_control {
    default "no-cache";
    ~^[0-9a-f]{16}$ "public, max-age=31536000, immutable";
}

map $http_accept_encoding $my_youtube_encoding_suffix {
    default "";
    ~*br ".br";
    ~*gzip ".gz";
}

map $http_accept_encoding $my_youtube_content_encoding {
    default "";
    ~*br "br";
    ~*gzip "gzip";
}

server {
    listen 80;
    server_name {{ domain }};
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ domain }};

    # TLS — managed by certbot
    ssl_certificate /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Security headers
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header X-DNS-Prefetch-Control off always;

    # Connection buffering
    client_max_body_size 10m;
    client_body_buffer_size 128k;
    proxy_buffering on;
    proxy_buffer_size 16k;
    proxy_buffers 8 32k;

    # Gzip
    gzip on;
    gzip_types text/css application/javascript application/json text/plain application/xml;
    gzip_min_length 1024;
    gzip_vary on;

    # Static assets — serve directly
    location /public/ {
        alias {{ app_dir }}/public/;
        expires 1d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location /vendor/ {
        alias {{ app_dir }}/node_modules/;
        expires 7d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location /fonts/ {
        alias {{ app_dir }}/public/fonts/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Express exposes public/ at the origin root; bypass Node for those URLs.
    location = /sw.js {
        root {{ app_dir }}/public;
        expires -1;
        add_header Cache-Control "no-cache";
        access_log off;
    }

    location ~ ^/(app|native-player-engine(?:\.min)?|player-(?:page|telemetry)(?:\.min)?|idb-helpers)\.js$ {
        root {{ app_dir }}/public;
        try_files $uri$my_youtube_encoding_suffix $uri =404;
        gzip off;
        expires off;
        add_header Cache-Control $my_youtube_runtime_cache_control always;
        add_header Content-Encoding $my_youtube_content_encoding always;
        add_header Vary Accept-Encoding always;
        access_log off;
    }

    location = /style.css {
        root {{ app_dir }}/public;
        try_files $uri$my_youtube_encoding_suffix $uri =404;
        gzip off;
        expires off;
        add_header Cache-Control $my_youtube_runtime_cache_control always;
        add_header Content-Encoding $my_youtube_content_encoding always;
        add_header Vary Accept-Encoding always;
        access_log off;
    }

    location ~ ^/(manifest\.json|favicon\.svg)$ {
        root {{ app_dir }}/public;
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
        access_log off;
    }

    location = /ws/status {
        limit_req zone=general burst=20 nodelay;
        proxy_pass http://my_youtube;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $my_youtube_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 60s;
    }

    # Poster/thumbnail cache
    location ~ ^/api/stream/[^/]+/(poster|thumb)$ {
        proxy_pass http://my_youtube;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_cache_valid 200 24h;
        proxy_cache_valid 404 30s;
        proxy_cache poster_cache;
        proxy_cache_lock on;
        add_header X-Cache-Status $upstream_cache_status;
    }

    location ~ ^/(channel/[^/]+/avatar|api/comments/avatar/.+)$ {
        proxy_pass http://my_youtube;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_cache_valid 200 24h;
        proxy_cache_valid 400 404 30s;
        proxy_cache poster_cache;
        proxy_cache_lock on;
        proxy_ignore_headers Set-Cookie;
        proxy_hide_header Set-Cookie;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # Storyboard sheets
    location ~ ^/api/stream/[^/]+/storyboard/[0-9]+$ {
        proxy_pass http://my_youtube;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_cache_valid 200 24h;
        proxy_cache_valid 404 30s;
        proxy_cache storyboard_cache;
        proxy_cache_lock on;
    }

    location ~ ^/api/stream/[A-Za-z0-9_-]{11}/status$ {
        limit_req zone=general burst=20 nodelay;
        proxy_pass http://my_youtube;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 60s;
        chunked_transfer_encoding off;
    }

    location = /api/stream/durations-live {
        limit_req zone=general burst=20 nodelay;
        proxy_pass http://my_youtube;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 45s;
        chunked_transfer_encoding off;
    }

    location ~ ^/api/stream/[A-Za-z0-9_-]{11}/prefetch$ {
        limit_req zone=extraction burst=5 nodelay;
        proxy_pass http://my_youtube;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
    }

    # Stream segments — pass through, don't buffer
    location ~ ^/api/stream/ {
        proxy_pass http://my_youtube;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
    }

    # All other routes
    location / {
        limit_req zone=general burst=20 nodelay;
        proxy_pass http://my_youtube;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
