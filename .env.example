# === Required in production ===
SESSION_SECRET=generate-a-random-64-char-string

# === PostgreSQL (optional — defaults to SQLite) ===
# DATABASE_URL=postgres://myyoutube:password@localhost:5432/myyoutube
# Set only when an external migration job has completed before this process.
# SKIP_DATABASE_MIGRATIONS=1

# === Redis (optional — enables clustering, sessions, locks, and job queue) ===
# REDIS_URL=redis://localhost:6379
# Optional isolation. Both fall back to REDIS_URL for existing deployments.
# CACHE_REDIS_URL=redis://localhost:6380
# QUEUE_REDIS_URL=redis://localhost:6379
# Clustered web workers require a working Redis session store. The SQLite
# fallback is intentionally limited to a single worker.
# ALLOW_CLUSTERED_SQLITE_SESSIONS=0
# REDIS_CONNECT_TIMEOUT_MS=2000
# REDIS_COMMAND_TIMEOUT_MS=2000
# SEGMENT_CACHE_WRITE_BUDGET_BYTES=134217728
# REDIS_OPERATION_TIMEOUT_MS=2000
# RSS_REFRESH_CONCURRENCY=6
# Enable only when the worker service is running; otherwise web workers retain
# the bounded in-process RSS scheduler.
# RSS_REFRESH_QUEUE_ENABLED=1
# RSS_QUEUE_WAIT_TIMEOUT_MS=25000
# RSS_QUEUE_BATCH_WAIT_TIMEOUT_MS=180000
# RSS_REFRESH_DEDUPE_MS=900000
# RSS_REFRESH_MAX_QUEUE=1000
# RSS_REFRESH_START_SPACING_MS=100
# RSS_REFRESH_JITTER_MS=5000
# RSS_REFRESH_GLOBAL_CONCURRENCY=8
# RSS_GLOBAL_SLOT_LEASE_MS=20000
# YT_REQUEST_GLOBAL_CONCURRENCY=30
# Optional explicit per-worker override; auto-sized from the global cap by default.
# YT_REQUEST_CONCURRENCY=7
# YT_REQUEST_MAX_QUEUE=1000
# YT_REQUEST_QUEUE_TIMEOUT_MS=10000
# YT_REQUEST_LEASE_MS=20000
# Saved-playlist metadata uses a bounded background queue in each web worker,
# plus Redis-backed cross-worker deduplication and an aggregate slot limit.
# PLAYLIST_REFRESH_CONCURRENCY=2
# PLAYLIST_REFRESH_GLOBAL_CONCURRENCY=4
# PLAYLIST_REFRESH_MAX_QUEUE=500
# PLAYLIST_REFRESH_LEASE_MS=60000
# PLAYLIST_REFRESH_WAIT_MS=60000
# PLAYLIST_CONTINUATION_TTL_MS=300000
# VIDEO_ENRICHMENT_RETRY_MS=300000
# LIVE_VIDEO_DETAILS_TTL_MS=120000
# Aggregate media response bodies across all web workers. The per-origin
# Undici pool remains a secondary backstop because `connections` is not global.
# OUTBOUND_MEDIA_GLOBAL_CONCURRENCY=128
# OUTBOUND_MEDIA_MAX_QUEUE=512
# OUTBOUND_MEDIA_QUEUE_TIMEOUT_MS=10000
# UNDICI_CONNECTIONS=16
# Legacy fallback used when OUTBOUND_MEDIA_GLOBAL_CONCURRENCY is unset.
# UNDICI_GLOBAL_CONNECTIONS=128
# SEGMENT_CACHE_COLLECTION_BUDGET_BYTES=16777216
# MAX_SEGMENT_FLIGHTS=128
# SEGMENT_FLIGHT_TIMEOUT_MS=45000
# WATCH_TIME_WRITE_DELAY_MS=5000
# WATCH_TIME_MAX_PENDING=10000
# WATCH_TIME_WRITE_CONCURRENCY=4
# DOWNLOAD_PROGRESS_UPDATE_MS=1000
# Per-video local-format indexes eliminate a filesystem stat on every segment.
# Keep these short enough to observe formats completed by another web worker.
# DOWNLOAD_MANIFEST_CACHE_TTL_MS=30000
# DOWNLOAD_MANIFEST_NEGATIVE_TTL_MS=5000
# TODAY_REFRESH_CHANNELS_PER_RUN=160
# TODAY_REFRESH_COMPLETION_BUDGET_MS=20000
# TODAY_LOCAL_REFRESH_CONCURRENCY=8
# TODAY_INCREMENTAL_TTL_MS=300000
# TODAY_PAGE_SIZE=60

# === Stream Auth (optional — auto-generated if not set, MUST be set for clustering) ===
# STREAM_SECRET=64-character-hex-string

# === Tuning ===
# PORT=3000
# WEB_CONCURRENCY=4
# Cache asynchronous browser-profile discovery used by cookie fallbacks/imports.
# BROWSER_DISCOVERY_TTL_MS=60000
# Bound off-thread parsing of YouTube's subscription response.
# SUBSCRIPTION_PARSE_TIMEOUT_MS=5000
# DATABASE_POOL_MAX=5
# DATABASE_CONNECT_TIMEOUT_MS=3000
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_QUERY_TIMEOUT_MS=15000
# Set to the exact number of trusted reverse-proxy hops in front of the app.
# Leave at 0 when clients connect directly.
# TRUST_PROXY_HOPS=0
# Aggregate status-channel budget is divided across clustered web workers.
# STATUS_MAX_CONNECTIONS=1000
# STATUS_MAX_CONNECTIONS_PER_IP=8
# STATUS_CONNECTION_MAX_AGE_MS=45000
# Duration batches use the same connection budget and a shorter bounded life.
# DURATION_STATUS_MAX_AGE_MS=30000
# STATUS_WS_MAX_BUFFERED_BYTES=262144
# MAX_METRIC_SERIES=2000
# CLUSTER_METRICS_TIMEOUT_MS=1500
# METRICS_CLUSTER_AGGREGATION=1
# METRICS_TOKEN=replace-with-a-long-random-token
# METRICS_ALLOW_PUBLIC=0
# METRICS_SNAPSHOT_TTL_MS=1000
# Only the stable slot-zero web worker polls BullMQ depth in clustered mode.
# QUEUE_METRICS_INTERVAL_MS=30000
# PLAYER_EVENT_LOG_SAMPLE_RATE=0.01
# Staging-only real-video canary. Keep IDs in repository/environment variables
# and credentials in secrets; see deploy/DEPLOY.md.
# PLAYER_CANARY_BASE_URL=https://staging.example.com
# PLAYER_CANARY_VIDEO_IDS=vod:BaW_jenozKc,live:REPLACE_ID,restricted:REPLACE_ID
# PLAYER_CANARY_SAMPLES=2
# PLAYER_CANARY_METRICS_TOKEN=replace-with-the-staging-metrics-token
# PLAYER_CANARY_COOKIE=connect.sid=replace-with-a-staging-session
# LOG_DETAIL_SAMPLE_RATE=0.05
# LOG_MAX_BUFFER_BYTES=1048576
# LOG_WRITE_BATCH_BYTES=65536
# EXPLORE_RICH_SCORE_CANDIDATE_LIMIT=2000
# Apply allocation-heavy text signals only to the best preliminary candidates.
# Feeds at or below this size retain the exact full-rich scorer.
# EXPLORE_RICH_TEXT_CANDIDATE_LIMIT=800
# Maximum recent watch rows used by a cold personalized Explore build.
# EXPLORE_PERSONAL_HISTORY_LIMIT=500
# Bound collaborative filtering to recent, active neighbors as history grows.
# EXPLORE_COWATCH_MAX_AGE_DAYS=90
# EXPLORE_COWATCH_MAX_USERS=500
# Limit each user's recent watch set when rebuilding incremental co-watch edges.
# EXPLORE_COWATCH_PER_USER_LIMIT=50
# Refresh co-watch edges on rewatch, not on every progress write.
# EXPLORE_COWATCH_REFRESH_INTERVAL_MINUTES=60
# One database-backed lease elects a single clustered maintenance runner.
# DATABASE_MAINTENANCE_INTERVAL_MS=3600000
# DATABASE_MAINTENANCE_INITIAL_DELAY_MS=30000
# DATABASE_MAINTENANCE_BATCH_SIZE=1000
# DATABASE_MAINTENANCE_MAX_BATCHES=10
# MAX_CONCURRENT_YTDLP=4
# YTDLP_MAX_QUEUE=128
# YTDLP_QUEUE_TIMEOUT_MS=75000
# Parse large upstream and yt-dlp JSON away from request/extraction event loops.
# Extraction uses a separate lane so large format payloads cannot delay smaller
# playlist and metadata responses.
# UPSTREAM_PARSE_WORKER=1
# UPSTREAM_PARSE_OFFLOAD_BYTES=262144
# UPSTREAM_PARSE_WORKER_MAX_PENDING=16
# UPSTREAM_PARSE_WORKER_TIMEOUT_MS=5000
# EXTRACTION_PARSE_WORKER=1
# EXTRACTION_PARSE_OFFLOAD_BYTES=262144
# EXTRACTION_PARSE_WORKER_MAX_PENDING=8
# EXTRACTION_PARSE_WORKER_TIMEOUT_MS=10000
# Dedicated download worker jobs; each job downloads at most one video and one audio format.
# DOWNLOAD_JOB_CONCURRENCY=2
# Bound queued videos globally and per opaque requester key.
# DOWNLOAD_QUEUE_MAX_JOBS=100
# DOWNLOAD_QUEUE_MAX_JOBS_PER_OWNER=5
# DOWNLOAD_QUEUE_ADMISSION_LEASE_MS=7200000
# DOWNLOAD_QUEUE_JOB_MAX_AGE_MS=600000
# Aggregate media-format streams across every download-worker replica.
# DOWNLOAD_FORMAT_GLOBAL_CONCURRENCY=4
# DOWNLOAD_FORMAT_SLOT_LEASE_MS=120000
# DOWNLOAD_FORMAT_SLOT_WAIT_MS=600000
# Reject oversized jobs and preserve a disk-space safety margin. Unknown
# upstream sizes reserve DOWNLOAD_UNKNOWN_FORMAT_RESERVATION_BYTES per format.
# DOWNLOAD_MAX_FORMAT_BYTES=12884901888
# DOWNLOAD_MAX_VIDEO_BYTES=21474836480
# DOWNLOAD_STORAGE_MAX_BYTES=214748364800
# DOWNLOAD_MIN_FREE_BYTES=2147483648
# DOWNLOAD_MIN_FREE_RATIO=0.05
# DOWNLOAD_UNKNOWN_FORMAT_RESERVATION_BYTES=2147483648
# DOWNLOAD_STORAGE_RESERVATION_LEASE_MS=7200000
# Periodically repair the O(1) storage ledger after crashes or manual file changes.
# DOWNLOAD_STORAGE_RECONCILE_INITIAL_DELAY_MS=60000
# DOWNLOAD_STORAGE_RECONCILE_INTERVAL_MS=3600000
# DOWNLOAD_STORAGE_RECONCILE_BATCH_SIZE=256
# DOWNLOAD_PART_MAX_AGE_MS=21600000
# Stream filesystem maintenance in bounded batches and yield after each budget.
# DOWNLOAD_MAINTENANCE_INITIAL_DELAY_MS=30000
# DOWNLOAD_MAINTENANCE_BATCH_SIZE=64
# DOWNLOAD_MAINTENANCE_TIME_BUDGET_MS=5000
# DOWNLOAD_MAINTENANCE_INTERVAL_MS=3600000
# DOWNLOAD_MANIFEST_CONCURRENCY=8
# DOWNLOAD_MANIFEST_BATCH_SIZE=256
# Deployment migration batch size for legacy SQLite RSS cache normalization.
# RSS_LEGACY_MIGRATION_BATCH_SIZE=200
# EXTRACTION_DEADLINE_MS=75000
# MAX_EXTRACTION_WORKERS=2
# EXTRACTION_REPLICAS=1
# Bound BullMQ ingress while reserving slots for clicked playback.
# EXTRACTION_QUEUE_MAX_JOBS=200
# EXTRACTION_QUEUE_PLAYBACK_RESERVE=50
# EXTRACTION_QUEUE_ADMISSION_LEASE_MS=900000
# EXTRACTION_QUEUE_JOB_MAX_AGE_MS=180000
# DURATION_NEGATIVE_TTL_MS=600000
# Run expensive SQLite Today and Explore reads on a read-only worker thread so
# they cannot block request handling. Disable only for non-production debugging;
# production load-sheds these reads instead of blocking the request thread.
# SQLITE_EXPLORE_WORKER=1
# SQLITE_EXPLORE_WORKER_TIMEOUT_MS=5000
# SQLITE_EXPLORE_WORKER_MAX_PENDING=64
# Maximum distinct keys retained by bounded single-flight registries unless a
# smaller operation-specific safety limit applies.
# SINGLEFLIGHT_MAX_KEYS=500
# MAX_METADATA_INFLIGHT=256
# Bound cross-worker cache objects. Extraction results are compacted before
# BullMQ/Redis and use the tighter extraction-specific ceiling.
# SHARED_CACHE_MAX_VALUE_BYTES=2097152
# EXTRACTION_CACHE_MAX_BYTES=1048576
# EXTRACTION_MAX_FORMATS=512
# EXTRACTION_MAX_STORYBOARD_FRAGMENTS=2000
# EXTRACTION_MAX_SUBTITLE_LANGUAGES=100
# MAX_VTT_BYTES=5242880
# Prevent pathological numbered-page offsets (default max offset is 250k rows
# at the largest supported 100-row API page).
# PAGINATION_MAX_PAGE=2500

# === Docker Compose secrets ===
# POSTGRES_PASSWORD=changeme
