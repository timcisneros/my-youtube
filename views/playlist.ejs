    <div class="playlist-header">
      <div>
        <h1><%= playlist.title %></h1>
        <div class="playlist-meta">
          <% if (playlist.channelId && playlist.channelTitle) { %>
            <a href="/channel/<%= playlist.channelId %>"><%= playlist.channelTitle %></a>
          <% } else if (playlist.channelTitle) { %>
            <span><%= playlist.channelTitle %></span>
          <% } %>
          <% if (playlist.itemCountText) { %><span><%= playlist.itemCountText %></span><% } %>
        </div>
      </div>
      <div class="playlist-actions">
        <% if (saved) { %>
          <button class="playlist-save-toggle saved" data-playlist-id="<%= playlist.playlistId %>">Saved</button>
        <% } else { %>
          <button class="playlist-save-toggle" data-playlist-id="<%= playlist.playlistId %>">Save</button>
        <% } %>
        <% const firstPlayable = playlist.items.find((item) => item.available && item.videoId); %>
        <% if (firstPlayable) { %>
          <a class="playlist-play-all" href="/watch?v=<%= firstPlayable.videoId %>&list=<%= playlist.playlistId %>&index=<%= firstPlayable.index %>">Play all</a>
        <% } %>
      </div>
    </div>

    <% if (pageToken) { %>
      <div class="playlist-page-note">
        Showing videos starting at <%= playlist.items[0] ? playlist.items[0].index : 1 %>. <a href="/playlist?list=<%= playlist.playlistId %>">Back to start</a>
      </div>
    <% } else if (isLocal && typeof localPage !== 'undefined' && localPage > 1) { %>
      <div class="playlist-page-note">
        Showing videos starting at <%= playlist.items[0] ? playlist.items[0].index : 1 %>. <a href="/playlist?list=<%= playlist.playlistId %>">Back to start</a>
      </div>
    <% } %>

    <form class="playlist-url-form" action="/playlist" method="get">
      <input type="text" class="sub-search" name="url" placeholder="Open a playlist URL or ID" autocomplete="off">
      <button class="import-btn" type="submit">Open</button>
    </form>

    <% if (isLocal) { %>
      <form class="playlist-url-form local-playlist-add-form" data-playlist-id="<%= playlist.playlistId %>">
        <input type="text" class="sub-search" name="video" placeholder="Add a video URL or ID" autocomplete="off">
        <input type="text" class="sub-search" name="title" placeholder="Optional title" autocomplete="off" maxlength="200">
        <button class="import-btn" type="submit">Add</button>
        <span class="import-status"></span>
      </form>
    <% } %>

    <script>
    (function() {
      var btn = document.querySelector('.playlist-save-toggle');
      if (btn) {
        btn.addEventListener('click', function() {
          var saved = btn.classList.contains('saved');
          btn.disabled = true;
          fetch('/playlists', {
            method: saved ? 'DELETE' : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ list: btn.dataset.playlistId })
          }).then(function(r) { return r.json(); }).then(function(data) {
            if (data.error) return;
            btn.classList.toggle('saved', !saved);
            btn.textContent = saved ? 'Save' : 'Saved';
          }).finally(function() { btn.disabled = false; }).catch(function() { btn.disabled = false; });
        });
      }
      function initPlaylistProgressiveLoading() {
        var loadMore = document.querySelector('.playlist-load-more');
        if (!loadMore || loadMore.dataset.progressiveBound) return;
        loadMore.dataset.progressiveBound = '1';
        var loadStatus = document.querySelector('.playlist-load-status');
        var playlistList = document.querySelector('.playlist-list');
        var maxItems = parseInt(loadMore.dataset.maxItems, 10) || 500;
        function addText(parent, className, text) {
          var node = document.createElement('div');
          node.className = className;
          node.textContent = text || '';
          parent.appendChild(node);
        }
        function buildRow(item) {
          var playable = item.available && item.videoId;
          var row = document.createElement(playable ? 'a' : 'div');
          row.className = 'playlist-row' + (playable ? '' : ' playlist-row-unavailable');
          if (playable) {
            row.href = '/watch?v=' + encodeURIComponent(item.videoId)
              + '&list=' + encodeURIComponent(loadMore.dataset.playlistId)
              + '&index=' + encodeURIComponent(item.index);
          }

          var index = document.createElement('span');
          index.className = 'playlist-row-index';
          index.textContent = item.index;
          row.appendChild(index);

          var thumb = document.createElement('div');
          thumb.className = 'playlist-row-thumb';
          if (item.videoId) {
            var image = document.createElement('img');
            image.src = '/api/stream/' + encodeURIComponent(item.videoId) + '/thumb';
            image.alt = '';
            image.className = 'video-thumb';
            image.width = 160;
            image.height = 90;
            image.loading = 'lazy';
            image.decoding = 'async';
            thumb.appendChild(image);
            var duration = document.createElement('span');
            duration.className = 'video-duration';
            duration.textContent = item.lengthText || '';
            thumb.appendChild(duration);
            var progress = document.createElement('div');
            progress.className = 'watch-progress';
            progress.dataset.progressId = item.videoId;
            thumb.appendChild(progress);
          }
          row.appendChild(thumb);

          var info = document.createElement('div');
          info.className = 'playlist-row-info';
          addText(info, 'video-title', item.title || 'Untitled video');
          if (item.channelTitle) addText(info, 'video-channel', item.channelTitle);
          if (!item.available) addText(info, 'video-time', item.unavailableReason || 'Unavailable');
          row.appendChild(info);
          return row;
        }
        loadMore.addEventListener('click', function() {
          if (!playlistList || loadMore.disabled) return;
          var loaded = parseInt(loadMore.dataset.loadedItems, 10) || 0;
          if (loaded >= maxItems) return;
          loadMore.disabled = true;
          loadMore.textContent = 'Loading…';
          if (loadStatus) loadStatus.textContent = '';
          var params = new URLSearchParams({
            list: loadMore.dataset.playlistId,
            pageToken: loadMore.dataset.pageToken,
            start: loadMore.dataset.nextStart
          });
          fetch('/playlist/continuation?' + params.toString(), {
            headers: { 'Accept': 'application/json' }
          }).then(function(response) {
            return response.json().then(function(data) {
              if (!response.ok) throw new Error(data.error || 'Could not load more videos');
              return data;
            });
          }).then(function(data) {
            var remaining = Math.max(0, maxItems - loaded);
            var items = Array.isArray(data.items) ? data.items.slice(0, remaining) : [];
            var fragment = document.createDocumentFragment();
            items.forEach(function(item) { fragment.appendChild(buildRow(item)); });
            loadWatchProgress(fragment);
            playlistList.appendChild(fragment);
            loaded += items.length;
            loadMore.dataset.loadedItems = loaded;
            loadMore.dataset.pageToken = data.nextPageToken || '';
            loadMore.dataset.nextStart = String(data.nextStart || (loaded + 1));
            if (!data.nextPageToken || !items.length || loaded >= maxItems) {
              loadMore.remove();
              if (loadStatus) {
                loadStatus.textContent = data.nextPageToken && loaded >= maxItems
                  ? 'Showing the first ' + maxItems + ' videos.'
                  : 'All available videos loaded.';
              }
              return;
            }
            loadMore.disabled = false;
            loadMore.textContent = 'Load more';
          }).catch(function(error) {
            loadMore.disabled = false;
            loadMore.textContent = 'Try again';
            if (loadStatus) loadStatus.textContent = error.message || 'Could not load more videos.';
          });
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPlaylistProgressiveLoading, { once: true });
      } else {
        initPlaylistProgressiveLoading();
      }
      var addForm = document.querySelector('.local-playlist-add-form');
      if (addForm) {
        addForm.addEventListener('submit', function(e) {
          e.preventDefault();
          var videoInput = addForm.querySelector('input[name="video"]');
          var titleInput = addForm.querySelector('input[name="title"]');
          var status = addForm.querySelector('.import-status');
          var video = videoInput ? videoInput.value.trim() : '';
          if (!video) return;
          status.innerHTML = '<span class="import-spinner"></span>Adding...';
          fetch('/playlists/' + addForm.dataset.playlistId + '/items', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ video: video, title: titleInput ? titleInput.value.trim() : '' })
          }).then(function(r) { return r.json(); }).then(function(data) {
            if (data.error) { status.textContent = data.error; return; }
            location.reload();
          }).catch(function() { status.textContent = 'Add failed'; });
        });
      }
      document.querySelectorAll('.local-playlist-item-btn').forEach(function(itemBtn) {
        itemBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          var method = itemBtn.dataset.action === 'remove' ? 'DELETE' : 'PATCH';
          fetch('/playlists/' + itemBtn.dataset.playlistId + '/items', {
            method: method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ videoId: itemBtn.dataset.videoId, direction: itemBtn.dataset.action })
          }).then(function() { location.reload(); }).catch(function() {});
        });
      });
    })();
    </script>

    <% if (playlist.items.length === 0) { %>
      <p class="empty">No videos found for this playlist.</p>
    <% } else { %>
      <div class="playlist-list">
        <% for (const v of playlist.items) { %>
          <% if (v.available && v.videoId && !isLocal) { %>
            <a href="/watch?v=<%= v.videoId %>&list=<%= playlist.playlistId %>&index=<%= v.index %>" class="playlist-row">
          <% } else { %>
            <div class="playlist-row<%= v.available ? '' : ' playlist-row-unavailable' %><%= isLocal ? ' playlist-row-local' : '' %>">
          <% } %>
              <span class="playlist-row-index"><%= v.index %></span>
              <div class="playlist-row-thumb">
                <% if (v.videoId) { %>
                  <img data-src="/api/stream/<%= v.videoId %>/thumb" alt="" class="video-thumb lazy-thumb" width="160" height="90">
                <% } %>
                <% if (v.videoId && typeof liveStatuses !== 'undefined' && liveStatuses[v.videoId] === 'is_live') { %><span class="video-badge live" data-video-id="<%= v.videoId %>">LIVE</span><% } else if (v.videoId && typeof liveStatuses !== 'undefined' && liveStatuses[v.videoId] === 'is_upcoming') { %><span class="video-badge upcoming" data-video-id="<%= v.videoId %>">UPCOMING</span><% } else if (v.lengthText) { %><span class="video-duration"><%= v.lengthText %></span><% } else if (v.videoId && typeof durations !== 'undefined' && durations[v.videoId]) { %><span class="video-duration" data-video-id="<%= v.videoId %>"><%= durations[v.videoId] %></span><% } else if (v.videoId) { %><span class="video-duration" data-video-id="<%= v.videoId %>"></span><% } %>
                <% if (v.videoId) { %><div class="watch-progress" data-progress-id="<%= v.videoId %>"></div><% } %>
              </div>
              <div class="playlist-row-info">
                <div class="video-title">
                  <% if (isLocal && v.available && v.videoId) { %>
                    <a href="/watch?v=<%= v.videoId %>&list=<%= playlist.playlistId %>&index=<%= v.index %>"><%= v.title %></a>
                  <% } else { %>
                    <%= v.title %>
                  <% } %>
                </div>
                <% if (v.channelTitle) { %><div class="video-channel"><%= v.channelTitle %></div><% } %>
                <% if (!v.available) { %><div class="video-time"><%= v.unavailableReason || 'Unavailable' %></div><% } %>
              </div>
              <% if (isLocal && v.videoId) { %>
                <div class="playlist-row-controls">
                  <button class="local-playlist-item-btn" data-action="up" data-playlist-id="<%= playlist.playlistId %>" data-video-id="<%= v.videoId %>" title="Move up">↑</button>
                  <button class="local-playlist-item-btn" data-action="down" data-playlist-id="<%= playlist.playlistId %>" data-video-id="<%= v.videoId %>" title="Move down">↓</button>
                  <button class="local-playlist-item-btn" data-action="remove" data-playlist-id="<%= playlist.playlistId %>" data-video-id="<%= v.videoId %>" title="Remove">&times;</button>
                </div>
              <% } %>
          <% if (v.available && v.videoId && !isLocal) { %>
            </a>
          <% } else { %>
            </div>
          <% } %>
        <% } %>
      </div>
      <% if (isLocal && (localPrevCursor || localNextCursor)) { %>
        <div class="pagination">
          <% if (localPrevCursor) { %><a href="/playlist?list=<%= playlist.playlistId %>&cursor=<%= encodeURIComponent(localPrevCursor) %>">&larr; Previous</a><% } %>
          <% if (localNextCursor) { %><a href="/playlist?list=<%= playlist.playlistId %>&cursor=<%= encodeURIComponent(localNextCursor) %>">Next &rarr;</a><% } %>
        </div>
      <% } else if (playlist.nextPageToken) { %>
        <div class="pagination playlist-progressive-controls">
          <button type="button" class="import-btn playlist-load-more"
            data-playlist-id="<%= playlist.playlistId %>"
            data-page-token="<%= playlist.nextPageToken %>"
            data-next-start="<%= nextStart %>"
                data-loaded-items="<%= nextStart - 1 %>"
            data-max-items="500">Load more</button>
          <span class="playlist-load-status" role="status" aria-live="polite"></span>
          <noscript><a href="/playlist?list=<%= playlist.playlistId %>&pageToken=<%= encodeURIComponent(playlist.nextPageToken) %>&start=<%= nextStart %>">Next page &rarr;</a></noscript>
        </div>
      <% } %>
    <% } %>
  </main>
